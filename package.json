    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.38",
    "@solana/web3.js": "^1.98.4",
    "@sunrisestake/client": "^0.1.16",
    "@torque-labs/torque-ts-sdk": "^0.0.136",
    "@vercel/analytics": "^2.0.1",
    "@wormhole-foundation/sdk-base": "^4.21.0",
    "@wormhole-foundation/sdk-definitions": "^4.21.0",
    "@wormhole-foundation/sdk-solana": "^4.21.0",
    "@wormhole-foundation/sdk-solana-core": "^4.21.0",
    "@wormhole-foundation/sdk-solana-ntt": "^4.0.14",
    "bs58": "^6.0.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.7",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "socialfi": "^0.1.14",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^25",
    "@types/qrcode.react": "^3.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.10.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
